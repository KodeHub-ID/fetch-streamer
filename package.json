{
  "name": "@kodehub.id/fetch-streamer",
  "version": "0.2.0",
  "description": "Zero-dependency SSE client using fetch + ReadableStream with custom header support",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/__tests__",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test:package": "bun run build && node scripts/smoke-test.mjs",
    "prepublishOnly": "bun run typecheck && bun run test && bun run test:package",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.7",
    "typescript": "^5.0.0",
    "vitest": "^4.1.7"
  },
  "keywords": [
    "sse",
    "server-sent-events",
    "eventsource",
    "fetch",
    "stream",
    "readable-stream"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KodeHub-ID/fetch-streamer.git"
  },
  "bugs": {
    "url": "https://github.com/KodeHub-ID/fetch-streamer/issues"
  },
  "homepage": "https://github.com/KodeHub-ID/fetch-streamer#readme",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.4.5"
}
